# =====================================================================
# Variables de entorno LOCALES del servicio de pagos (EJEMPLO)
# Copiar a ".env" y reemplazar con valores reales.
# NO subir este archivo a Git con valores reales.
# =====================================================================

# --- Equipo ---
TEAM_CODE=EQUIPO_A

# --- BANCO ---
BANK_BASE_URL=https://gdsi5lyj34.execute-api.us-east-1.amazonaws.com/prod
BANK_API_KEY=your-bank-api-key-here

# --- ERP ---
ERP_BASE_URL=https://gdsi5lyj34.execute-api.us-east-1.amazonaws.com/prod
ERP_API_KEY=your-erp-api-key-here

# --- TERCERA API (mock local) ---
THIRD_BASE_URL=http://localhost:8089
THIRD_API_KEY=dev-key

# --- Header de simulacion ---
BANK_SIM_SCENARIO=
ERP_SIM_SCENARIO=
THIRD_SIM_SCENARIO=

# --- Infraestructura LOCAL ---
DB_URL=jdbc:mariadb://mariadb:3306/hidrogest
DB_USER=hidrogest
DB_PASSWORD=hidrogest
RABBIT_HOST=rabbitmq
RABBIT_USER=guest
RABBIT_PASSWORD=guest
