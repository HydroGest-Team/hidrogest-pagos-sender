# =====================================================================
# Variables de entorno de pagos-sender (EJEMPLO). Copiar a ".env" y completar.
# ".env" está en .gitignore: los valores reales NUNCA se suben al repositorio.
# Los valores de abajo sirven para correr la app desde el IDE contra el docker compose local;
# dentro de compose, docker-compose.yml sobrescribe los hosts (mariadb, rabbitmq, ...).
# =====================================================================

# --- Equipo (debe coincidir con la API key: EQUIPO_A ⇒ llaves EQA-000123) ---
TEAM_CODE=EQUIPO_A
# Opcional: prefijo distinto para las llaves de idempotencia (vacío = derivado de TEAM_CODE)
IDEMPOTENCY_KEY_PREFIX=
DESTINOS_ACTIVOS=BANCO,ERP,TERCERO

# --- BANCO (simulador del docente en AWS) ---
BANK_BASE_URL=https://REEMPLAZAR_API_ID.execute-api.us-east-1.amazonaws.com/prod
BANK_API_KEY=reemplazar-con-la-llave-del-equipo

# --- ERP (mismo API Gateway que el banco mientras el docente no indique otro) ---
ERP_BASE_URL=https://REEMPLAZAR_API_ID.execute-api.us-east-1.amazonaws.com/prod
ERP_API_KEY=reemplazar-con-la-llave-del-equipo

# --- TERCERA API (contrato provisional; en local la atiende el mock de docker compose) ---
THIRD_BASE_URL=http://localhost:8089
THIRD_API_KEY=reemplazar-con-una-llave-local

# --- X-Simulation-Scenario (solo pruebas; vacío = no se envía) ---
# SUCCESS | SLOW | TIMEOUT | LOST_ACK | ERROR_500 | ERROR_503 | RATE_LIMIT | AUTO
BANK_SIM_SCENARIO=
ERP_SIM_SCENARIO=
THIRD_SIM_SCENARIO=

# --- BD de HidroGest: usuario de SOLO LECTURA (en compose se crea con estos valores) ---
DB_URL=jdbc:mariadb://localhost:3306/hidrogest
DB_USER=pagos_ro
DB_PASSWORD=reemplazar

# --- Solo docker compose local: administración de la MariaDB réplica ---
MARIADB_ROOT_PASSWORD=reemplazar
HIDROGEST_APP_PASSWORD=reemplazar

# --- RabbitMQ ---
RABBIT_HOST=localhost
RABBIT_USER=guest
RABBIT_PASSWORD=reemplazar

# --- DynamoDB (endpoint vacío = AWS real con credenciales estándar del SDK) ---
AWS_REGION=us-east-1
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_CREAR_TABLAS=true

# --- Endpoint /admin y métricas (Basic Auth). Vacío = cerrados ---
ADMIN_USER=admin
ADMIN_PASSWORD=reemplazar
